# Confera web application: local settings.
# Copy to .env (never committed). There is no secret in this file and the web
# application must never be given one (ADR-26): it only renders and forwards.

# Stage: exactly one of local, dev, test, prod. There is no default (ADR-24).
# local, dev and test start only when both origins below are loopback or .test names.
STAGE=local

# The two surfaces (ADR-02). They must be different host names (another port is not another
# host: a cookie does not tell ports apart), and the same two as in
# confera_be (ADMIN_ORIGIN, PUBLIC_ORIGIN): on a developer machine "localhost" is the admin
# host and "127.0.0.1" the public host, two names for the same computer.
# Public surface: hosted forms, the embed frame, secure-link pages, /public/v1.
CONFERA_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Admin surface: admin and sign-in pages, /api/v1.
CONFERA_ADMIN_ORIGIN=http://localhost:3000

# Where the web application forwards /api/v1 and /public/v1 (the confera_be API).
CONFERA_API_ORIGIN=http://127.0.0.1:3001

# Port of the web application (next dev / next start).
PORT=3000

# Address the web application listens on (next dev / next start). The default is 127.0.0.1
# outside prod (this machine only) and 0.0.0.0 on prod (inside its container). On local, dev
# and test anything but a loopback address stops the start (ADR-24), as in confera_be.
# LISTEN_HOST=127.0.0.1
